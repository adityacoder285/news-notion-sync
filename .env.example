# --- newsdata.io (free key: https://newsdata.io) ---
NEWSDATA_API_KEY=your_newsdata_key_here

# --- Notion (https://www.notion.so/my-integrations) ---
NOTION_API_KEY=secret_your_notion_token

# A Notion page your integration can edit.
# Used to create the database and the per-category pages.
NOTION_PARENT_PAGE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: reuse an existing database instead of creating a new one.
# NOTION_DATABASE_ID=

# --- Optional tuning ---
NEWS_CATEGORIES=top,technology,business
NEWS_LANGUAGE=en
# NEWS_COUNTRY=us
MAX_ARTICLES=8
